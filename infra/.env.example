# Copy to infra/.env (never commit the real file) and fill in every value.
# `docker-compose.prod.yml` reads this via `env_file: .env` for api/worker/scheduler.

APP_KEY=
APP_URL=https://api.guyub.example
FRONTEND_URL=https://guyub.example

# Managed Postgres, smallest tier with PITR (PRD §25.1) — not a container here.
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=guyub
DB_USERNAME=
DB_PASSWORD=

# S3-compatible object storage (e.g. Cloudflare R2 — free egress matters, PRD §25.6).
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_ENDPOINT=

# Real SMTP for transactional mail (not mailpit — that's local-only).
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@guyub.example
MAIL_FROM_NAME=GUYUB

# GYB config-as-data (config/guyub.php, config/guyub-legal.php) — see F0.9,
# these stay blank until the legal entity/registration is real.
GUYUB_BRAND_NAME=GUYUB
GUYUB_OPS_WHATSAPP=
GUYUB_OPS_EMAIL=
GUYUB_DATA_CONTROLLER_NAME=
GUYUB_CONTACT_ADDRESS=
GUYUB_NIB=
GUYUB_NPWP=
GUYUB_PSE_KOMINFO_REGISTERED=false

# Push (FCM) — merchant order alarm depends on this (PRD §6.5).
FIREBASE_CREDENTIALS=

# GUYUB auth (PRD §36). Pepper MUST be a real random secret, generated once,
# backed up outside this VPS (F0.8) — losing it invalidates every PIN.
# otp_provider has no real driver yet (no WhatsApp Business API / SMS
# gateway account exists) — do not deploy phone+PIN auth to real users
# until GUYUB_OTP_PROVIDER points at something other than `log`. See
# infra/README.md "Not done yet".
GUYUB_PIN_PEPPER=
GUYUB_OTP_PROVIDER=log

# Free-tier error tracking (PRD §25.1).
SENTRY_LARAVEL_DSN=
